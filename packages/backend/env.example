# Commands
# npx convex dev
# npx convex env set --from-file .env

# Set Convex environment variables
# npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
# npx convex env set SITE_URL http://localhost:8081
# Same as CONVEX_URL but ends in .site
# EXPO_PUBLIC_CONVEX_SITE_URL=
# Web app URL for authentication (for Expo web support)
SITE_URL=http://localhost:8081
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=<dev: parts of CONVEX_URL>

CONVEX_URL=<url...  convex.cloud>

CONVEX_SITE_URL=<url...  .convex.site>

# Polar organization token
POLAR_ORGANIZATION_TOKEN=<polar access token>
# Polar webhook secret
# POLAR_WEBHOOK_SECRET=<token genereated after creating the Polar webhook at https://<your-convex-site-url>/polar/events in polar dashboard>
# Polar environment: sandbox or production
POLAR_SERVER=<sandbox or production>
